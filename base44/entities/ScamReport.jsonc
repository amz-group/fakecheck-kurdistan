{
  "name": "ScamReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the scam report"
    },
    "scam_type": {
      "type": "string",
      "enum": [
        "phishing",
        "fake_prize",
        "otp_scam",
        "investment",
        "job_scam",
        "crypto_scam",
        "impersonation",
        "fake_shop",
        "other"
      ],
      "description": "Category of the scam"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the scam"
    },
    "url": {
      "type": "string",
      "description": "Suspicious URL associated with the scam"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number involved in the scam"
    },
    "platform": {
      "type": "string",
      "enum": [
        "whatsapp",
        "telegram",
        "facebook",
        "instagram",
        "tiktok",
        "sms",
        "email",
        "website",
        "other"
      ],
      "description": "Platform where the scam occurred"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Screenshot image URL"
    },
    "country_region": {
      "type": "string",
      "description": "Country or region of the report"
    },
    "report_count": {
      "type": "number",
      "default": 1,
      "description": "Number of times this scam has been reported"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status of the report"
    },
    "is_trending": {
      "type": "boolean",
      "default": false,
      "description": "Whether this scam is trending"
    }
  },
  "required": [
    "title",
    "scam_type",
    "description",
    "platform",
    "status"
  ]
}