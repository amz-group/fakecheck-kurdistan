{
  "name": "SuspiciousDomain",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "The suspicious domain name"
    },
    "reason": {
      "type": "string",
      "description": "Reason the domain was flagged"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "suspicious",
        "high"
      ],
      "default": "suspicious",
      "description": "Risk level of the domain"
    },
    "category": {
      "type": "string",
      "enum": [
        "phishing",
        "malware",
        "fake_shop",
        "impersonation",
        "scam",
        "other"
      ],
      "default": "scam",
      "description": "Category of suspicious activity"
    }
  },
  "required": [
    "domain",
    "risk_level"
  ]
}