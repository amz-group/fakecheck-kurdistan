{
  "name": "TrendingScam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the trending scam"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "suspicious",
        "high"
      ],
      "default": "suspicious",
      "description": "Risk level of the scam"
    },
    "report_count": {
      "type": "number",
      "default": 1,
      "description": "Number of reports for this scam"
    },
    "platform": {
      "type": "string",
      "enum": [
        "whatsapp",
        "telegram",
        "facebook",
        "instagram",
        "tiktok",
        "sms",
        "email",
        "website",
        "other"
      ],
      "default": "other",
      "description": "Platform where the scam spreads"
    },
    "first_reported_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the scam was first reported"
    },
    "latest_report_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the scam was most recently reported"
    },
    "description": {
      "type": "string",
      "description": "Short description of the scam"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "suspicious",
        "investigating"
      ],
      "default": "suspicious",
      "description": "Verification status of the scam"
    },
    "is_trending": {
      "type": "boolean",
      "default": true,
      "description": "Whether this scam currently has a trending badge"
    }
  },
  "required": [
    "title",
    "risk_level",
    "status"
  ]
}